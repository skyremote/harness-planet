{
  "name": "harness-planet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Every coding-agent thread on your machine - Claude Code, Codex, Cursor, bb and more - as a little bot on a planet. A NavAIgate fork of Bot Crossing by Jarren Rocks.",
  "license": "MIT",
  "author": "NavAIgate (fork of Bot Crossing by Jarren Rocks)",
  "homepage": "https://github.com/skyremote/harness-planet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyremote/harness-planet.git"
  },
  "bugs": {
    "url": "https://github.com/skyremote/harness-planet/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "vite": "^7.1.0"
  }
}
